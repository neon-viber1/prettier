exports[`embedded-in-html-block.md - {"proseWrap":"always"} format 1`] = `
====================================options=====================================
parsers: ["markdown"]
proseWrap: "always"
                                                      printWidth: 80 (default) |
=====================================input======================================
<div>this is necessary</div>
<!-- prettier-ignore -->
<pre>

the blank line above is also necessary
  indent this line please
  and don't invent a blank after my code
  in fact, don't reformat preformatted text at all
</pre>


=====================================output=====================================
<div>this is necessary</div>
<!-- prettier-ignore -->
<pre>

the blank line above is also necessary
  indent this line please
  and don't invent a blank after my code
  in fact, don't reformat preformatted text at all
</pre>

================================================================================
`;

