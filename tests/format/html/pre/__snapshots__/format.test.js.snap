// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`blank-first-line.html format 1`] = `
====================================options=====================================
parsers: ["html"]
                                                      printWidth: 80 (default) |
=====================================input======================================
<pre>

x</pre>
<pre></pre>
<pre>
</pre>

=====================================output=====================================
<pre>

x</pre>
<pre></pre>
<pre></pre>

================================================================================
`;

